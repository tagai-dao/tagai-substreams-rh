DATABASE_URL=postgres://tiptag@127.0.0.1:5433/tiptag_rh?sslmode=disable
SUBSTREAMS_ENDPOINT=robinhood.substreams.pinax.network:443
PACKAGE_PATH=/opt/tiptag-substreams/tiptag-unified-substreams-v0.1.0.spkg
# Set this to the common legacy/Basket cursor plus one at cutover time.
START_BLOCK=CHANGE_ME
STOP_BLOCK=
MODULE_HASH_MISMATCH_POLICY=error
CURSORS_TABLE=unified_cursors
HISTORY_TABLE=unified_substreams_history
INCREMENTAL_MAX_BLOCKS=100000
# If a sparse batch produces no cursor-bearing output, the next invocation
# doubles its range up to this ceiling. It never skips or manufactures cursors.
INCREMENTAL_MAX_BLOCKS_CEILING=1600000
INCREMENTAL_WINDOW_GROWTH_FACTOR=2
# Recommended when a cursor table contains rows from more than one output hash.
# This must be the output module's 40-character hexadecimal hash.
INCREMENTAL_CURSOR_ID=
